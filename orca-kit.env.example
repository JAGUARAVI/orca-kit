#!/usr/bin/env bash
# orca-kit config — ONE place for machine-specific values. Sourced by every kit script.
#
# Copy to ~/.orca-kit.env (or /etc/orca-kit.env) and edit, or export the vars in your shell.
# Every script falls back to a sane default when a value is unset, so the kit runs out of the box
# on a single-user machine and scales to a multi-host team setup.
#
# Nothing here contains secrets — secrets live in the per-person env files (see doc 05).

# ---- identity ----------------------------------------------------------------
# The user that runs Orca/agents/CI on this host.
KIT_USER="${KIT_USER:-$(id -un 2>/dev/null || echo "$USER")}"
# Default owner name (used for `.orca-owner` fallbacks and routing). Not necessarily a GitHub login.
KIT_OWNER="${KIT_OWNER:-$KIT_USER}"

# ---- base directories --------------------------------------------------------
# Home of the kit and its sibling trees. Default to the login user's home.
KIT_HOME="${KIT_HOME:-$HOME}"
KIT_DIR="${KIT_DIR:-$KIT_HOME/orca-kit}"          # this kit
DOCS_DIR="${DOCS_DIR:-$KIT_HOME/orca-docs}"        # technical docs mirror
WELCOME_DIR="${WELCOME_DIR:-$KIT_HOME/orca-welcome}" # team-facing docs
BIN_DIR="${BIN_DIR:-$KIT_HOME/bin}"                # helper scripts live here
LOCAL_BIN="${LOCAL_BIN:-$KIT_HOME/.local/bin}"     # per-person wrappers live here
OPENCODE_BIN_DIR="${OPENCODE_BIN_DIR:-$KIT_HOME/.opencode/bin}"

# ---- runtime state -----------------------------------------------------------
MERGE_DIR="${MERGE_DIR:-$KIT_HOME/.orca-merge}"    # merge-agent mailbox/logs
KEYS_DIR="${KEYS_DIR:-$KIT_HOME/.orca-keys}"       # per-person env files
PEOPLE_DIR="${PEOPLE_DIR:-$KIT_HOME/.orca-people}" # per-person config dirs
HACKATHON_DIR="${HACKATHON_DIR:-$KIT_HOME/.orca-hackathon}" # per-repo configs
REPO_DIR="${REPO_DIR:-$KIT_HOME/$(basename "${REPO_DIR:-repo}")}" # active repo checkout

# ---- model / agent -----------------------------------------------------------
# The default model id passed to agents (provider/model). Point at your own deployment.
MODEL="${MODEL:-fireworks-azure/Avi-DeepSeek-V4.1-Flash}"
# Default TUI agent launcher for dispatch/merge/plan.
AGENT_BIN="${AGENT_BIN:-$LOCAL_BIN/opencode2}"
AGENT_NAME="${AGENT_NAME:-opencode2}"

# ---- GitHub ------------------------------------------------------------------
# Which `gh` wrapper to use by default (a <Name>-gh script on PATH, or plain `gh`).
GH="${GH:-gh}"
# Repo slug is discovered from the checkout's origin remote when unset.
REPO_SLUG="${REPO_SLUG:-}"
BASE_BRANCH="${BASE_BRANCH:-main}"

# ---- CI runner ---------------------------------------------------------------
RUNNER_DIR="${RUNNER_DIR:-$KIT_HOME/actions-runner}"
RUNNER_LABELS="${RUNNER_LABELS:-self-hosted,linux,x64,orca-vm}"
RUNNER_PORTS="${RUNNER_PORTS:-4173 4174}"

export KIT_USER KIT_OWNER KIT_HOME KIT_DIR DOCS_DIR WELCOME_DIR BIN_DIR LOCAL_BIN OPENCODE_BIN_DIR \
       MERGE_DIR KEYS_DIR PEOPLE_DIR HACKATHON_DIR REPO_DIR MODEL AGENT_BIN AGENT_NAME GH REPO_SLUG \
       BASE_BRANCH RUNNER_DIR RUNNER_LABELS RUNNER_PORTS