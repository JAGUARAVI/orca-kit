#!/usr/bin/env bash
# orca-gh-add — authenticate a person's GitHub account for Orca agents.
# Gives them an isolated gh config dir (GH_CONFIG_DIR) + git identity, so their
# gh commands AND git pushes use their own account.
#
# Usage: orca-gh-add <Name> [token]
#   token: a PAT (classic: repo, workflow, project, read:org). Omit to login interactively.
set -euo pipefail
. "$(dirname "$0")/../lib/orca-kit.sh"

name="${1:?usage: orca-gh-add <Name> [token]}"
token="${2:-}"
K="${KEYS_DIR:-$HOME/.orca-keys}"
P="${PEOPLE_DIR:-$HOME/.orca-people}/$name"
GH_CFG="$P/gh"
umask 077; mkdir -p "$GH_CFG"; chmod 700 "$P" "$GH_CFG"
[ -z "$token" ] && token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"

# the gh executable to configure with (respect a wrapper on PATH, else gh)
GH_BIN="$(command -v gh || echo gh)"

if [ -n "$token" ]; then
  printf '%s' "$token" | GH_CONFIG_DIR="$GH_CFG" "$GH_BIN" auth login --hostname github.com --git-protocol https --with-token
fi

# git must use gh's credential helper (it reads GH_CONFIG_DIR at runtime -> per person)
git config --global --replace-all 'credential.https://github.com.helper' ''
git config --global --add 'credential.https://github.com.helper' "!$GH_BIN auth git-credential"
git config --global --replace-all 'credential.https://gist.github.com.helper' ''
git config --global --add 'credential.https://gist.github.com.helper' "!$GH_BIN auth git-credential"

f="$K/$name.env"; touch "$f"; chmod 600 "$f"
set_kv(){ if grep -q "^$1=" "$f"; then sed -i "s|^$1=.*|$1=$2|" "$f"; else printf '%s=%s\n' "$1" "$2" >> "$f"; fi; }
set_kv GH_CONFIG_DIR "$GH_CFG"

if GH_CONFIG_DIR="$GH_CFG" "$GH_BIN" auth status >/dev/null 2>&1; then
  login=$(GH_CONFIG_DIR="$GH_CFG" "$GH_BIN" api user --jq .login)
  id=$(GH_CONFIG_DIR="$GH_CFG" "$GH_BIN" api user --jq .id)
  set_kv GH_USER "$login"
  set_kv GIT_AUTHOR_NAME "$login"
  set_kv GIT_AUTHOR_EMAIL "${id}+${login}@users.noreply.github.com"
  set_kv GIT_COMMITTER_NAME "$login"
  set_kv GIT_COMMITTER_EMAIL "${id}+${login}@users.noreply.github.com"
  echo "✓ $name authenticated as $login"
  echo "  GH_CONFIG_DIR=$GH_CFG"
else
  echo "GH_CONFIG_DIR set for $name, but no login yet."
  echo "Authenticate with a token:  orca-gh-add $name <PAT>"
  echo "or interactively:  GH_CONFIG_DIR=$GH_CFG $GH_BIN auth login --hostname github.com --git-protocol https"
fi