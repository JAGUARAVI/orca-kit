# Orca automated merge agent for a specific repo. Template: %i = the repo config name in
# /home/<user>/.orca-hackathon/%i.env . Select the user with the instance's User= via a drop-in.
# Install:
#   sudo cp systemd/orca-merge-agent@.service /etc/systemd/system/
#   sudo cp systemd/orca-merge-agent@.timer   /etc/systemd/system/
#   sudo systemctl enable --now 'orca-merge-agent@<repo>.timer'
[Unit]
Description=Orca automated merge agent (one pass) for repo %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ORCA_HACKATHON_CONFIG=%h/.orca-hackathon/%i.env
ExecStart=%h/bin/orca-merge-agent