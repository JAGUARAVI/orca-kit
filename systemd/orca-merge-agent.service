[Unit]
Description=Orca automated merge agent (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/bin/orca-merge-agent
